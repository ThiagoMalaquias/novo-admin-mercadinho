<div class="space-y-6">
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
    <div>
      <h1 class="text-2xl font-bold text-gray-900 dark:text-white">Relatórios</h1>
      <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">Todos os relatórios gerados pelo sistema</p>
    </div>
  </div>

  <div class="bg-white dark:bg-gray-800 rounded-xl shadow-sm border border-gray-200 dark:border-gray-700 overflow-hidden">
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-gray-200 dark:divide-gray-700">
        <thead class="bg-gray-50 dark:bg-gray-900">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">Nome</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">Link</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">Data de criação</th>
            <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">Ações</th>
          </tr>
        </thead>
        <tbody class="bg-white dark:bg-gray-800 divide-y divide-gray-200 dark:divide-gray-700">
          <% if @relatorios.any? %>
            <% @relatorios.each do |relatorio| %>
              <tr class="hover:bg-gray-50 dark:hover:bg-gray-700/50 transition-colors">
                <td class="px-6 py-4">
                  <div class="text-sm font-medium text-gray-900 dark:text-white"><%= relatorio.nome %></div>
                  <% unless relatorio.concluido? %>
                    <div class="mt-1 text-xs text-gray-500 dark:text-gray-400 capitalize"><%= relatorio.status %></div>
                  <% end %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm">
                  <% if relatorio.link_download.present? %>
                    <%= link_to "Baixar XLSX", relatorio.link_download, target: "_blank", class: "text-blue-600 hover:text-blue-800 dark:text-blue-400 font-medium" %>
                  <% else %>
                    <span class="text-gray-400 dark:text-gray-500">Aguardando geração</span>
                  <% end %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500 dark:text-gray-400">
                  <%= relatorio.created_at.strftime("%d/%m/%Y %H:%M") %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-right text-sm">
                  <%= link_to relatorio_path(relatorio),
                              method: :delete,
                              data: { confirm: "Tem certeza que deseja excluir este relatório?" },
                              class: "p-2 text-red-600 hover:text-red-900 dark:text-red-400 dark:hover:text-red-300 hover:bg-red-50 dark:hover:bg-red-900/20 rounded-lg transition-colors inline-flex",
                              title: "Excluir" do %>
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                    </svg>
                  <% end %>
                </td>
              </tr>
            <% end %>
          <% else %>
            <tr>
              <td colspan="4" class="px-6 py-8 text-center text-sm text-gray-500 dark:text-gray-400">
                Nenhum relatório encontrado.
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

  <% if @relatorios.respond_to?(:total_pages) && @relatorios.total_pages > 1 %>
    <div class="dark px-6 py-4">
      <div class="apple_pagination flex items-center justify-center">
        <%= will_paginate @relatorios, container: false, class: 'flex items-center gap-2' %>
      </div>
    </div>
  <% end %>
</div>
