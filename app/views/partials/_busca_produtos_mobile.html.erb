<%= form_with url: url, method: :get, local: true, html: { class: "md:hidden relative" } do %>
  <%= text_field_tag :q, params[:q],
    placeholder: placeholder,
    class: "w-full pl-10 pr-4 py-2.5 text-sm border border-gray-300 dark:border-gray-700 rounded-lg bg-white dark:bg-gray-800 text-gray-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-blue-500" %>
  <button type="submit" class="absolute left-3 top-3 text-gray-400 hover:text-gray-600 dark:hover:text-gray-300" aria-label="Buscar produtos">
    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
    </svg>
  </button>
<% end %>
